PORT=5200
NODE_ENV=development
DATABASE_URL="postgresql://sovereign_user:sovereign_pass@localhost:5432/sovereign_db?schema=public" # or "file:./dev.db" for SQLite
JWT_SECRET="your_secure_jwt_secret_here"
JWT_EXPIRES_IN="7d"
CLIENT_URL="http://localhost:5173"

# YouTube Channel Continuous Synchronization Module (@official_eyobhaile)
YOUTUBE_API_KEY="AIzaSy..." # Google Cloud YouTube Data API v3 Key
YOUTUBE_CHANNEL_HANDLE="@official_eyobhaile"
YOUTUBE_CALLBACK_URL="https://api.yourdomain.com/api/youtube/webhook" # Public URL for Google PubSubHubbub webhooks
YOUTUBE_WEBHOOK_SECRET="your_hmac_sha1_secret_for_push_verification"
YOUTUBE_RECONCILE_INTERVAL_MINUTES=30 # Periodic background reconciliation interval
