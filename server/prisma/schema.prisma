datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. IDENTITY & ACCESS CONTROL
// ----------------------------------------------------

model User {
  id               String          @id @default(uuid())
  email            String          @unique
  passwordHash     String
  firstName        String
  lastName         String
  phone            String?
  avatarUrl        String?
  status           String          @default("ACTIVE") // ACTIVE, PENDING, SUSPENDED
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  lastLoginAt      DateTime?

  // Relations
  roles            UserRole[]
  sessions         Session[]
  authProviders    AuthProvider[]
  loginActivities  LoginActivity[]
  securityEvents   SecurityEvent[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  notificationPref NotificationPreference?
  telegramLink     TelegramLink?
  
  // Member relation (one-to-one)
  member           Member?
  
  // Content authored
  announcements    Announcement[]
  posts            Post[]
  comments         Comment[]
  postReactions    PostReaction[]
  messagesSent     Message[]
  eventsOrganized  Event[]
  verificationsDone MemberVerification[]
  expensesApproved Expense[]
  mentorshipNotes  MentorshipNote[]
}

model Role {
  id          String           @id @default(uuid())
  name        String           @unique // SUPER_ADMIN, ADMIN, ORGANIZER, MENTOR, MEMBER, VOLUNTEER, FINANCE_MANAGER, CONTENT_MANAGER
  description String?
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id          String           @id @default(uuid())
  name        String           @unique
  module      String           // auth, members, events, finance, learning, etc.
  description String?
  roles       RolePermission[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthProvider {
  id         String   @id @default(uuid())
  userId     String
  provider   String   // GOOGLE, TELEGRAM, LOCAL
  providerId String
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model LoginActivity {
  id        String   @id @default(uuid())
  userId    String?
  email     String?
  ipAddress String?
  userAgent String?
  status    String   // SUCCESS, FAILED
  message   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SecurityEvent {
  id        String   @id @default(uuid())
  userId    String?
  eventType String   // PASSWORD_RESET, PERMISSION_DENIED, SUSPICIOUS_LOGIN, BRUTE_FORCE
  severity  String   // LOW, MEDIUM, HIGH, CRITICAL
  ipAddress String?
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ----------------------------------------------------
// 2. MEMBERSHIP
// ----------------------------------------------------

model MembershipType {
  id           String   @id @default(uuid())
  name         String   // FOUNDING, EXECUTIVE, GENERAL, YOUNG_LEADER
  code         String   @unique
  fee          Float    @default(0)
  billingCycle String   @default("ANNUAL") // MONTHLY, QUARTERLY, ANNUAL
  benefits     String?  // JSON or text list of perks
  isActive     Boolean  @default(true)
  members      Member[]
}

model Member {
  id               String              @id @default(uuid())
  userId           String              @unique
  memberNumber     String              @unique
  membershipTypeId String
  status           String              @default("ACTIVE") // PENDING, ACTIVE, INACTIVE, SUSPENDED, EXPIRED
  joinDate         DateTime            @default(now())
  renewalDate      DateTime?
  digitalIdCode    String              @unique
  qrCodeUrl        String?
  badgeTier        String              @default("STANDARD") // BRONZE, SILVER, GOLD, SOVEREIGN_COUNCIL
  serviceHoursTotal Float              @default(0)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  membershipType   MembershipType      @relation(fields: [membershipTypeId], references: [id])
  profile          MemberProfile?
  verifications    MemberVerification[]
  documents        MemberDocument[]
  interests        MemberInterest[]
  skills           MemberSkill[]
  registrations    EventRegistration[]
  attendances      Attendance[]
  feedbacks        EventFeedback[]
  enrollments      Enrollment[]
  certificates     Certificate[]
  lessonProgresses LessonProgress[]
  mentorProfile    Mentor?
  mentorshipMatches MentorshipMatch[]  @relation("MenteeMatches")
  workoutSessions  WorkoutSession[]
  fitnessProgress  FitnessProgress[]
  challengeEntries ChallengeParticipant[]
  businessProfile  BusinessProfile?
  careerProfile    CareerProfile?
  jobApplications  JobApplication[]
  volunteerRoles   ProjectVolunteer[]
  serviceHours     ServiceHour[]
  invoices         Invoice[]
  payments         Payment[]
  groupMemberships GroupMember[]
}

model MemberProfile {
  id               String   @id @default(uuid())
  memberId         String   @unique
  bio              String?
  dateOfBirth      DateTime?
  city             String?
  country          String?  @default("United States")
  profession       String?
  company          String?
  linkedinUrl      String?
  telegramHandle   String?
  emergencyContact String?
  tShirtSize       String?  // S, M, L, XL, XXL
  avatarUrl        String?
  member           Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model MemberApplication {
  id                  String   @id @default(uuid())
  fullName            String
  email               String
  phone               String?
  occupation          String?
  company             String?
  city                String?
  reasonToJoin        String
  source              String   @default("PORTAL") // DIRECT, GOOGLE_FORMS, REFERRAL
  status              String   @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, APPROVED, REJECTED
  reviewedByUserId    String?
  reviewNotes         String?
  googleFormResponseId String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model MemberVerification {
  id               String   @id @default(uuid())
  memberId         String
  verifiedByUserId String
  verifiedAt       DateTime @default(now())
  verificationType String   // ID_DOCUMENT, INTERVIEW, BACKGROUND_CHECK
  status           String   @default("VERIFIED") // PENDING, VERIFIED, REJECTED
  notes            String?

  member           Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  verifiedBy       User     @relation(fields: [verifiedByUserId], references: [id])
}

model MemberDocument {
  id           String   @id @default(uuid())
  memberId     String
  title        String
  documentType String   // ID_CARD, PASSPORT, RESUME, CERTIFICATE
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  status       String   @default("PENDING") // PENDING, APPROVED, REJECTED
  uploadedAt   DateTime @default(now())

  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model MemberInterest {
  id        String   @id @default(uuid())
  memberId  String
  interest  String   // Fitness, Business, Mentorship, Leadership, Wealth
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, interest])
}

model MemberSkill {
  id          String   @id @default(uuid())
  memberId    String
  skill       String
  proficiency String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, EXPERT
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, skill])
}

// ----------------------------------------------------
// 3. COMMUNITY & COMMUNICATION
// ----------------------------------------------------

model Announcement {
  id             String   @id @default(uuid())
  title          String
  content        String
  priority       String   @default("NORMAL") // NORMAL, HIGH, URGENT
  targetAudience String   @default("ALL") // ALL, COUNCIL, MENTORS
  authorId       String
  telegramSent   Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  author         User     @relation(fields: [authorId], references: [id])
}

model Post {
  id            String         @id @default(uuid())
  authorId      String
  content       String
  mediaUrl      String?
  likesCount    Int            @default(0)
  commentsCount Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments      Comment[]
  reactions     PostReaction[]
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model PostReaction {
  id           String   @id @default(uuid())
  postId       String
  userId       String
  reactionType String   @default("LIKE") // LIKE, RESPECT, SALUTE, FIRE
  createdAt    DateTime @default(now())

  post         Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Group {
  id          String        @id @default(uuid())
  name        String
  description String?
  category    String        // Fitness, Investment, Books, Tech, Service
  leaderId    String?
  imageUrl    String?
  createdAt   DateTime      @default(now())

  members     GroupMember[]
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  memberId  String
  role      String   @default("MEMBER") // LEADER, MODERATOR, MEMBER
  joinedAt  DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([groupId, memberId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ALERT
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotificationPreference {
  id              String   @id @default(uuid())
  userId          String   @unique
  emailEnabled    Boolean  @default(true)
  pushEnabled     Boolean  @default(true)
  telegramEnabled Boolean  @default(true)
  inAppEnabled    Boolean  @default(true)

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramLink {
  id               String    @id @default(uuid())
  userId           String    @unique
  telegramChatId   String?
  telegramUsername String?
  verificationCode String?
  isVerified       Boolean   @default(false)
  linkedAt         DateTime?

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MessageThread {
  id        String    @id @default(uuid())
  subject   String?
  isGroup   Boolean   @default(false)
  createdAt DateTime  @default(now())
  messages  Message[]
}

model Message {
  id        String        @id @default(uuid())
  threadId  String
  senderId  String
  content   String
  createdAt DateTime      @default(now())

  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender    User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 4. EVENTS & ATTENDANCE
// ----------------------------------------------------

model EventCategory {
  id        String   @id @default(uuid())
  name      String   @unique // Summit, Workout, Mastermind, Service, Social
  color     String   @default("#c99738")
  icon      String?
  events    Event[]
}

model EventLocation {
  id        String   @id @default(uuid())
  name      String
  address   String?
  city      String?
  mapUrl    String?
  isVirtual Boolean  @default(false)
  virtualLink String?
  events    Event[]
}

model Event {
  id                  String              @id @default(uuid())
  title               String
  description         String
  categoryId          String
  locationId          String?
  organizerId         String
  startTime           DateTime
  endTime             DateTime
  capacity            Int                 @default(50)
  registeredCount     Int                 @default(0)
  status              String              @default("PUBLISHED") // DRAFT, PUBLISHED, COMPLETED, CANCELLED
  coverImage          String?
  telegramBroadcasted Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  category            EventCategory       @relation(fields: [categoryId], references: [id])
  location            EventLocation?      @relation(fields: [locationId], references: [id])
  organizer           User                @relation(fields: [organizerId], references: [id])
  registrations       EventRegistration[]
  attendances         Attendance[]
  feedbacks           EventFeedback[]
}

model EventRegistration {
  id           String   @id @default(uuid())
  eventId      String
  memberId     String
  status       String   @default("CONFIRMED") // CONFIRMED, WAITLIST, CANCELLED
  registeredAt DateTime @default(now())

  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
}

model Attendance {
  id          String   @id @default(uuid())
  eventId     String
  memberId    String
  checkedInBy String?
  checkedInAt DateTime @default(now())
  method      String   @default("QR_SCAN") // QR_SCAN, MANUAL

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
}

model EventFeedback {
  id        String   @id @default(uuid())
  eventId   String
  memberId  String
  rating    Int      // 1 to 5
  comments  String?
  createdAt DateTime @default(now())

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
}

// ----------------------------------------------------
// 5. LEARNING & KNOWLEDGE
// ----------------------------------------------------

model Course {
  id            String           @id @default(uuid())
  title         String
  slug          String           @unique
  description   String
  category      String           // Leadership, Wealth, Mindset, Mastery
  level         String           @default("INTERMEDIATE") // FOUNDATION, INTERMEDIATE, ADVANCED
  instructor    String
  coverImage    String?
  status        String           @default("PUBLISHED") // DRAFT, PUBLISHED
  modulesCount  Int              @default(0)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  modules       CourseModule[]
  resources     LearningResource[]
  enrollments   Enrollment[]
  certificates  Certificate[]
}

model CourseModule {
  id         String   @id @default(uuid())
  courseId   String
  title      String
  orderIndex Int      @default(0)

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons    Lesson[]
}

model Lesson {
  id              String           @id @default(uuid())
  moduleId        String
  title           String
  description     String?
  content         String?
  videoUrl        String?
  durationMinutes Int              @default(15)
  orderIndex      Int              @default(0)

  module          CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progresses      LessonProgress[]
}

model LearningResource {
  id           String   @id @default(uuid())
  courseId     String?
  title        String
  fileUrl      String
  resourceType String   // PDF, GUIDE, SPREADSHEET, AUDIO
  fileSize     Int?
  createdAt    DateTime @default(now())

  course       Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
}

model Enrollment {
  id              String    @id @default(uuid())
  courseId        String
  memberId        String
  status          String    @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED
  progressPercent Float     @default(0)
  enrolledAt      DateTime  @default(now())
  completedAt     DateTime?

  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  member          Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([courseId, memberId])
}

model LessonProgress {
  id          String    @id @default(uuid())
  lessonId    String
  memberId    String
  isCompleted Boolean   @default(false)
  completedAt DateTime?

  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([lessonId, memberId])
}

model Certificate {
  id                String   @id @default(uuid())
  courseId          String
  memberId          String
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  fileUrl           String?

  course            Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  member            Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([courseId, memberId])
}

model BookRecommendation {
  id          String   @id @default(uuid())
  title       String
  author      String
  description String
  category    String   // Philosophy, Finance, Leadership, Health
  coverImage  String?
  link        String?
  createdAt   DateTime @default(now())
}

model Podcast {
  id            String   @id @default(uuid())
  title         String
  host          String
  episodeNumber Int
  duration      String
  audioUrl      String?
  description   String
  createdAt     DateTime @default(now())
}

// ----------------------------------------------------
// 6. MENTORSHIP
// ----------------------------------------------------

model Mentor {
  id              String            @id @default(uuid())
  memberId        String            @unique
  expertise       String            // Finance, Tech, Real Estate, Health, Leadership
  yearsExperience Int               @default(5)
  bio             String
  maxMentees      Int               @default(3)
  activeMentees   Int               @default(0)
  isAvailable     Boolean           @default(true)
  createdAt       DateTime          @default(now())

  member          Member            @relation(fields: [memberId], references: [id], onDelete: Cascade)
  matches         MentorshipMatch[]
}

model MentorshipMatch {
  id          String              @id @default(uuid())
  mentorId    String
  menteeId    String
  matchedAt   DateTime            @default(now())
  status      String              @default("ACTIVE") // ACTIVE, COMPLETED, PAUSED
  focusArea   String

  mentor      Mentor              @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  mentee      Member              @relation("MenteeMatches", fields: [menteeId], references: [id], onDelete: Cascade)
  sessions    MentorshipSession[]
  goals       MentorshipGoal[]
  notes       MentorshipNote[]

  @@unique([mentorId, menteeId])
}

model MentorshipSession {
  id              String          @id @default(uuid())
  matchId         String
  scheduledAt     DateTime
  durationMinutes Int             @default(45)
  status          String          @default("SCHEDULED") // SCHEDULED, COMPLETED, CANCELLED
  meetingLink     String?
  agenda          String?
  summaryNotes    String?
  createdAt       DateTime        @default(now())

  match           MentorshipMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model MentorshipGoal {
  id          String          @id @default(uuid())
  matchId     String
  title       String
  description String?
  targetDate  DateTime?
  status      String          @default("IN_PROGRESS") // IN_PROGRESS, ACHIEVED, CANCELLED
  createdAt   DateTime        @default(now())

  match       MentorshipMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
}

model MentorshipNote {
  id        String          @id @default(uuid())
  matchId   String
  authorId  String
  note      String
  isPrivate Boolean         @default(false)
  createdAt DateTime        @default(now())

  match     MentorshipMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  author    User            @relation(fields: [authorId], references: [id])
}

// ----------------------------------------------------
// 7. FITNESS & DISCIPLINE
// ----------------------------------------------------

model FitnessProgram {
  id            String   @id @default(uuid())
  title         String
  description   String
  difficulty    String   @default("INTERMEDIATE") // BEGINNER, INTERMEDIATE, ADVANCED, BEAST
  durationWeeks Int      @default(6)
  instructor    String
  coverImage    String?
  createdAt     DateTime @default(now())

  workoutPlans  WorkoutPlan[]
}

model FitnessChallenge {
  id           String                 @id @default(uuid())
  title        String
  description  String
  startDate    DateTime
  endDate      DateTime
  goalMetric   String                 // Pushups, Miles Run, Days Logged, Fasting Hours
  targetValue  Float
  status       String                 @default("ACTIVE") // UPCOMING, ACTIVE, COMPLETED
  createdAt    DateTime               @default(now())

  participants ChallengeParticipant[]
}

model ChallengeParticipant {
  id           String           @id @default(uuid())
  challengeId  String
  memberId     String
  currentValue Float            @default(0)
  isCompleted  Boolean          @default(false)
  joinedAt     DateTime         @default(now())

  challenge    FitnessChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  member       Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([challengeId, memberId])
}

model WorkoutPlan {
  id          String           @id @default(uuid())
  programId   String
  title       String
  dayOfWeek   Int              // 1 to 7
  description String?

  program     FitnessProgram   @relation(fields: [programId], references: [id], onDelete: Cascade)
  sessions    WorkoutSession[]
}

model WorkoutSession {
  id              String       @id @default(uuid())
  memberId        String
  workoutPlanId   String?
  date            DateTime     @default(now())
  durationMinutes Int          @default(45)
  caloriesBurned  Int?
  notes           String?

  member          Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  workoutPlan     WorkoutPlan? @relation(fields: [workoutPlanId], references: [id], onDelete: SetNull)
}

model FitnessProgress {
  id            String   @id @default(uuid())
  memberId      String
  date          DateTime @default(now())
  weight        Float?
  bodyFat       Float?
  pushupsCount  Int?
  pullupsCount  Int?
  runningPace   String?
  notes         String?

  member        Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 8. MONEY & BUSINESS
// ----------------------------------------------------

model BusinessOpportunity {
  id              String   @id @default(uuid())
  title           String
  company         String
  description     String
  investmentRange String?
  contactPerson   String?
  contactEmail    String?
  status          String   @default("OPEN") // OPEN, CLOSED, EVALUATING
  createdAt       DateTime @default(now())
}

model BusinessProfile {
  id           String   @id @default(uuid())
  memberId     String   @unique
  businessName String
  industry     String
  website      String?
  description  String?
  lookingFor   String?  // Investors, Partners, Clients, Mentorship
  offering     String?  // Advisory, Services, Joint Ventures
  createdAt    DateTime @default(now())

  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 9. CAREER & PROFESSIONAL GROWTH
// ----------------------------------------------------

model CareerProfile {
  id              String           @id @default(uuid())
  memberId        String           @unique
  headline        String
  currentRole     String
  company         String?
  experienceYears Int              @default(3)
  resumeUrl       String?
  skills          String?          // comma separated or JSON
  createdAt       DateTime         @default(now())

  member          Member           @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model JobPost {
  id             String           @id @default(uuid())
  title          String
  company        String
  location       String
  employmentType String           @default("FULL_TIME") // FULL_TIME, CONTRACT, PART_TIME
  salaryRange    String?
  description    String
  requirements   String?
  postedByUserId String
  status         String           @default("OPEN") // OPEN, CLOSED
  createdAt      DateTime         @default(now())

  applications   JobApplication[]
}

model JobApplication {
  id        String   @id @default(uuid())
  jobId     String
  memberId  String
  coverNote String?
  resumeUrl String?
  status    String   @default("SUBMITTED") // SUBMITTED, REVIEWING, INTERVIEWING, REJECTED, HIRED
  appliedAt DateTime @default(now())

  job       JobPost  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([jobId, memberId])
}

// ----------------------------------------------------
// 10. COMMUNITY SERVICE & IMPACT
// ----------------------------------------------------

model ServiceProject {
  id               String             @id @default(uuid())
  title            String
  description      String
  location         String
  leaderId         String?
  startDate        DateTime
  endDate          DateTime?
  targetVolunteers Int                @default(15)
  targetHours      Float              @default(100)
  status           String             @default("ACTIVE") // UPCOMING, ACTIVE, COMPLETED
  createdAt        DateTime           @default(now())

  volunteers       ProjectVolunteer[]
  serviceHours     ServiceHour[]
  impactRecords    ImpactRecord[]
}

model ProjectVolunteer {
  id        String         @id @default(uuid())
  projectId String
  memberId  String
  role      String         @default("VOLUNTEER") // LEAD, VOLUNTEER, LOGISTICS
  status    String         @default("CONFIRMED") // CONFIRMED, CANCELLED
  joinedAt  DateTime       @default(now())

  project   ServiceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member    Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([projectId, memberId])
}

model ServiceHour {
  id           String         @id @default(uuid())
  projectId    String
  memberId     String
  hours        Float
  date         DateTime       @default(now())
  verifiedById String?
  notes        String?
  status       String         @default("VERIFIED") // PENDING, VERIFIED

  project      ServiceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  member       Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model ImpactRecord {
  id          String         @id @default(uuid())
  projectId   String
  metricName  String         // Meals Served, Youth Mentored, Dollars Raised, Trees Planted
  metricValue Float
  description String?

  project     ServiceProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------
// 11. FINANCE & PAYMENTS
// ----------------------------------------------------

model FinancialCategory {
  id        String    @id @default(uuid())
  name      String    @unique // Dues, Event Tickets, Sponsorship, Equipment, Venue, Charity
  type      String    // INCOME, EXPENSE
  expenses  Expense[]
  incomes   Income[]
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique
  memberId      String
  amount        Float
  dueDate       DateTime
  status        String    @default("PENDING") // PENDING, PAID, OVERDUE, CANCELLED
  itemsJson     String?   // Description of line items
  createdAt     DateTime  @default(now())

  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  payments      Payment[]
}

model Payment {
  id              String   @id @default(uuid())
  invoiceId       String?
  memberId        String
  amount          Float
  paymentMethod   String   @default("CREDIT_CARD") // CREDIT_CARD, BANK_TRANSFER, CRYPTO, CASH
  referenceNumber String?
  status          String   @default("COMPLETED") // COMPLETED, PENDING, FAILED
  paidAt          DateTime @default(now())

  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  member          Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model Expense {
  id           String            @id @default(uuid())
  categoryId   String
  title        String
  amount       Float
  date         DateTime          @default(now())
  receiptUrl   String?
  approvedById String?
  notes        String?
  createdAt    DateTime          @default(now())

  category     FinancialCategory @relation(fields: [categoryId], references: [id])
  approvedBy   User?             @relation(fields: [approvedById], references: [id], onDelete: SetNull)
}

model Income {
  id         String            @id @default(uuid())
  categoryId String
  title      String
  amount     Float
  date       DateTime          @default(now())
  source     String            @default("MEMBERSHIP_DUES")
  notes      String?
  createdAt  DateTime          @default(now())

  category   FinancialCategory @relation(fields: [categoryId], references: [id])
}

// ----------------------------------------------------
// 12. ADMINISTRATION, AUDIT & INTEGRATIONS
// ----------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String   // CREATE, UPDATE, DELETE, VERIFY, APPROVE, LOGIN
  entity    String   // Member, Application, Event, Finance, User
  entityId  String?
  details   String?  // JSON string
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SystemSetting {
  id          String  @id @default(uuid())
  key         String  @unique
  value       String
  description String?
  isPublic    Boolean @default(false)
}

model Integration {
  id          String    @id @default(uuid())
  serviceName String    @unique // GOOGLE_FORMS, GOOGLE_SHEETS, GOOGLE_DRIVE, TELEGRAM_BOT
  status      String    @default("CONNECTED") // CONNECTED, DISCONNECTED, ERROR
  configJson  String?   // Encrypted/safe configuration JSON
  lastSyncAt  DateTime?
  syncCount   Int       @default(0)
  errorLog    String?
  updatedAt   DateTime  @updatedAt
}
